node_modules
package-lock.json
_*.mjs

# Local provider credentials. Keep an example file explicitly opt-in if one is
# ever added; generated-audio keys must never enter source control.
.env
.env.*
!.env.example

# Single-file builds from `npm run bundle`. A few megabytes of base64, and
# rebuildable in one command, so they do not belong in the history.
dist/

# Browser verifier screenshots are local release evidence, not runtime files.
artifacts/

# Generated sound effects are large and rebuildable from assets/sfx/manifest.json
# with `npm run sfx`. Uncomment to keep them out of the repo:
# assets/sfx/*.mp3

# Regenerate with: npm run sfx:listen
assets/sfx/_listen.html
.claude/worktrees/
