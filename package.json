{
  "name": "squatch-smash",
  "version": "0.1.0",
  "private": true,
  "description": "Squatch Life -- a first-person apartment you wake up in, with a gaming PC that runs Squatch Smash.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "start": "node tools/serve.mjs",
    "sfx": "node tools/generate-sfx.mjs",
    "sfx:dry": "node tools/generate-sfx.mjs --dry-run",
    "check": "node tools/check.mjs",
    "verify:art": "node tools/verify-art.mjs",
    "verify:bing": "node tools/verify-bing.mjs",
    "bundle": "node tools/bundle-preview.mjs",
    "sfx:voices": "node tools/generate-sfx.mjs --voices",
    "sfx:vo": "node tools/generate-sfx.mjs --voice-only",
    "sfx:listen": "node tools/sfx-index.mjs",
    "radio:cues": "node tools/radio-cues.mjs",
    "audio:todo": "node tools/audio-todo.mjs",
    "verify:silver": "node tools/verify-silver.mjs"
  },
  "devDependencies": {
    "playwright": "^1.49.0"
  }
}
